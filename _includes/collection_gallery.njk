{# Parameters: collectionName, facet_by, only #}
{% set collectionName = galleryCollection if galleryCollection else "unstable_archives" %}
{% set galleryItems = collections[collectionName] %}

{% if only and facet_by %}
  {% set subset = galleryItems | where(facet_by, only) | sortBy('order') %}
{% endif %}

<div id='wax-gallery-{{ collectionName }}-container' class='wax-gallery-container full-width'>
  <div class='wax-inline-container'>
    <div id="{{ collectionName }}-facet-buttons" class="facet-buttons"></div>
    <div id="wax-gallery-{{ collectionName }}" class="wax-gallery"></div>
  </div>
</div>


<script type="text/javascript">
  $( document ).ready(function() {
    var container = $('#wax-gallery-{{ collectionName }}-container');
    var gallery = $('#wax-gallery-{{ collectionName }}');
    var buttonDiv = $('#{{ collectionName }}-facet-buttons');

    {% if subset %}
      {% for item in subset %}
        {% set facetClass = item.data[facet_by] | slugify if facet_by and item.data[facet_by] else '' %}
        gallery.append("<div class='gallery-item {{ facetClass }} all'><a href='{{ item.url | absolute_url }}'><div class='hovereffect'><img class='img-responsive gallery-thumb' src='{{ item.data.thumbnail | absolute_url }}'/><div class='overlay'><p class='info'>{{ item.data.label | escape }}</p></div></div></a></div>");
      {% endfor %}
    {% else %}
      {% for item in galleryItems %}
        {% set facetClass = item.data[facet_by] | slugify if facet_by and item.data[facet_by] else '' %}
        gallery.append("<div class='gallery-item {{ facetClass }} all'><a href='{{ item.url | absolute_url }}'><div class='hovereffect'><img class='img-responsive gallery-thumb' src='{{ item.data.thumbnail | absolute_url }}' alt='{{ item.data.label | escape }}'/><div class='overlay'><p class='info'>{{ item.data.label | escape }}</p></div></div></a></div>");
      {% endfor %}
    {% endif %}

    {% if facet_by %}
      {% if not subset %}
        var facets = Array.from(new Set([{% for item in galleryItems %}'{{ item.data[facet_by] | slugify }}'{% if not loop.last %}, {% endif %}{% endfor %}]));
        buttonDiv.append("<button class='btn facet active' data-filter='all'>show all</button>");

        for (i in facets) {
          buttonDiv.append(`<button class='btn facet' data-filter='${facets[i]}'>${facets[i]}</button>`);
        }

        $(document).ready(function(){
          $(".facet").click(function(){
            var filterValue = $(this).attr('data-filter');
            $('.facet').removeClass('active');
            $(this).addClass('active');
            if(filterValue == 'all') { $('.all').show('slow'); }
            else { $('.all').hide('slow'); $(`.${filterValue}`).show('slow'); }
          });
        });
      {% endif %}
    {% endif %}
  });
</script>
